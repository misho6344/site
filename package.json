{
  "name": "noadframe",
  "version": "2.0.0",
  "private": true,
  "description": "NoAdFrame — Watch. Enjoy. No Ads. Movie discovery site with IMDb ratings, accounts, comments and a site-scoped AI assistant.",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
    "preview": "node preview/server.js",
    "test": "node --test",
    "inventory:full": "node scripts/inventory-full-database.js",
    "compare:database:content": "node scripts/compare-database-content.js",
    "verify:database-pair": "node scripts/verify-database-pair.js",
    "restore:public-catalog": "node scripts/restore-public-catalog.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.0"
  }
}
