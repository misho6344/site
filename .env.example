PORT=3000

# Enzonic MySQL connection string (TLS required; use the exact URL from Enzonic Console)
# Example shape only — never commit your real credentials:
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# Keep TLS enabled for Enzonic. Set false ONLY for local MySQL without TLS.
DB_SSL=true

# Long random string, 32+ characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

OMDB_API_KEY=your_omdb_api_key
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini

# Email of the account that may add/delete movies (register it normally first)
ADMIN_EMAIL=you@example.com

# Optional: comma-separated list of allowed origins if the frontend is hosted on another domain
# CORS_ORIGIN=https://your-domain.com

# Set NODE_ENV=production on the deployed service to enable Secure cookies and production checks.
# NODE_ENV=production

# Password reset email (Resend). Required in production.
RESEND_API_KEY=your_resend_api_key
MAIL_FROM=NoAdFrame <no-reply@example.com>
APP_BASE_URL=https://your-domain.example
# Optional full reset URL; default is /#/reset-password
# PASSWORD_RESET_URL=https://your-domain.example/#/reset-password

# Shared, cross-instance rate limits (recommended for production)
# Create a Redis database at Upstash and keep both values private.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_private_upstash_token

# Optional: require Cloudflare to add this secret header before requests reach Render.
# Do not enable until the Cloudflare Transform Rule is configured.
# ORIGIN_ACCESS_TOKEN=generate-a-long-random-secret
# Numeric trusted proxy hops. Defaults: 0 locally, 1 on Render. Never use "true".
# TRUST_PROXY_HOPS=1
