PORT=3000

# TiDB Cloud / MySQL connection string (no ?ssl=... needed, TLS is enabled automatically)
DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/DATABASE
# Set to false ONLY for a local MySQL without TLS
DB_SSL=true

# Long random string, 32+ characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

OMDB_API_KEY=your_omdb_api_key
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini

# Email of the account that may add/delete movies (register it normally first)
ADMIN_EMAIL=you@example.com

# Optional: comma-separated list of allowed origins if the frontend is hosted on another domain
# CORS_ORIGIN=https://your-domain.com
